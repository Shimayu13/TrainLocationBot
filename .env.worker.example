# Worker only: never copy the Mac mini's .env here.
AI_ENABLED=true
# Enable only after image input is verified on this Mac. Text works with false.
AI_IMAGES_ENABLED=false
AI_WORKER_TOKEN=
# Loopback by default. For LAN, use the laptop's LAN IP (or 0.0.0.0) AND set allowed IPs.
AI_WORKER_HOST=127.0.0.1
AI_WORKER_PORT=8000
# Comma-separated source IPs/CIDRs of the Mac mini. Example: 192.168.1.10/32
AI_WORKER_ALLOWED_IPS=
AI_TEMPERATURE=0.7
AI_TOP_P=0.9
AI_MAX_RESPONSE_TOKENS=0
