DISCORD_BOT_TOKEN=
ODPT_CHALLENGE_CONSUMER_KEY=
ODPT_STANDARD_CONSUMER_KEY=
ODPT_CHALLENGE_BASE_URL=https://api-challenge.odpt.org/api/v4
ODPT_STANDARD_BASE_URL=https://api.odpt.org/api/v4
ODPT_PUBLIC_BASE_URL=https://api-public.odpt.org/api/v4
AI_ENABLED=true
AI_TIMEOUT_SECONDS=90
AI_MAX_PENDING=4
AI_MAX_SESSIONS=32
# Legacy settings below are retained for compatibility; no automatic clearing.
AI_SESSION_TTL_SECONDS=1800
AI_MAX_TURNS=8
AI_MAX_INPUT_CHARS=2000
AI_TEMPERATURE=0.7
AI_TOP_P=0.9
# 0 means no explicit response token cap; a cap can cut off sentences.
AI_MAX_RESPONSE_TOKENS=0
# Adaptive ensemble: Mini handles Discord; Pro/Air run trainbot.worker.
AI_CLUSTER_ENABLED=false
AI_WORKER_URLS=
# Shared random worker-only secret (at least 32 characters). Never a Discord/API key.
AI_WORKER_TOKEN=
# Total queue + generation + synthesis deadline. Individual generation uses AI_TIMEOUT_SECONDS.
AI_CLUSTER_TIMEOUT_SECONDS=240
# Local Mini image inference: set false if its model cannot read images.
AI_IMAGES_ENABLED=true
LOG_LEVEL=INFO
